{
  "name": "taste",
  "version": "1.0.0",
  "description": "A local, agent-friendly visual library for macOS.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && tsc -b && vite build",
    "start": "node dist-node/server/index.js",
    "taste": "node dist-node/cli/index.js",
    "test": "pnpm build && node --test dist-node/server/*.test.js dist-node/cli/*.test.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  }
}
